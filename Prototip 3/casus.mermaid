graph TD
    %% Actores
    Usuario([Usuario])
    Cliente([Cliente])
    Servidor([Servidor])
    BBDD([BBDD])

    %% Casos de uso
    UC1((Introducir credenciales))
    UC2((Enviar petición login))
    UC3((Validar credenciales))
    UC4((Generar token))
    UC5((Consultar usuario))
    UC6((Guardar token))
    UC7((Validar token))
    UC8((Verificar token))
    UC9((Proveer acceso a recurso))

    %% Relaciones actor -> caso de uso
    Usuario --> UC1
    Cliente --> UC2
    Servidor --> UC3
    Servidor --> UC4
    Servidor --> UC7
    Servidor --> UC9
    BBDD --> UC5
    BBDD --> UC6
    BBDD --> UC8

    %% Relaciones entre casos de uso (include)
    UC2 --> UC3
    UC3 --> UC5
    UC4 --> UC6
    UC9 --> UC7
    UC7 --> UC8
