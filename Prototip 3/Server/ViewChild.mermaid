graph LR
    %% Actores
    Usuario([Usuario])
    Cliente([Cliente])
    Servidor([Servidor])
    BBDD([BBDD])

    %% Casos de uso (acciones)
    UC1((Ver datos del hijo))
    UC2((Solicitar datos al servidor))
    UC3((Validar acceso))
    UC4((Consultar datos del hijo))

    %% Relaciones actor -> acciones
    Usuario --> UC1
    Cliente --> UC2
    Servidor --> UC3
    Servidor --> UC4
    BBDD --> UC4

    %% Relaciones entre casos de uso
    UC1 --> UC2
    UC2 --> UC3
    UC3 --> UC4
